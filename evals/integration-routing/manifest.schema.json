{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WikiSkill evaluation contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "skillId", "source", "budgets", "thresholds", "fixtures", "resultSets"],
  "properties": {
    "$schema": { "const": "./manifest.schema.json" },
    "version": { "const": 1 },
    "skillId": { "const": "integration-routing" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "hash", "revision", "purposePath", "purposeHash"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }, "hash": { "$ref": "#/$defs/hash" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "purposePath": { "type": "string", "minLength": 1 }, "purposeHash": { "$ref": "#/$defs/hash" }
      }
    },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["maxCandidateTokens", "maxEvaluationSeconds"],
      "properties": { "maxCandidateTokens": { "type": "integer", "minimum": 1, "maximum": 100000 }, "maxEvaluationSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 } }
    },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["minimumAggregateImprovement", "requireNoCriticalRegression"],
      "properties": { "minimumAggregateImprovement": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "requireNoCriticalRegression": { "type": "boolean" } }
    },
    "fixtures": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "hash", "visibility", "critical", "weight"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "path": { "type": "string", "minLength": 1 }, "hash": { "$ref": "#/$defs/hash" },
          "visibility": { "enum": ["public", "holdout"] }, "critical": { "type": "boolean" }, "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
        }
      }
    },
    "resultSets": {
      "type": "object", "additionalProperties": false,
      "required": ["baseline", "beneficial", "harmful", "no-op"],
      "properties": { "baseline": { "$ref": "#/$defs/resultSet" }, "beneficial": { "$ref": "#/$defs/resultSet" }, "harmful": { "$ref": "#/$defs/resultSet" }, "no-op": { "$ref": "#/$defs/resultSet" } }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "resultSet": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "hash", "artifactPath", "artifactHash"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "hash": { "$ref": "#/$defs/hash" }, "artifactPath": { "type": "string", "minLength": 1 }, "artifactHash": { "$ref": "#/$defs/hash" } }
    }
  }
}
