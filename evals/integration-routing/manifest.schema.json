{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WikiSkill evaluation contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "skillId", "source", "budgets", "thresholds", "fixtures", "resultSets"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "skillId": { "const": "integration-routing" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash", "revision", "purposePath"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "revision": { "type": "string", "minLength": 1 },
        "purposePath": { "type": "string", "minLength": 1 }
      }
    },
    "budgets": { "type": "object", "required": ["maxCandidateTokens", "maxEvaluationSeconds"] },
    "thresholds": { "type": "object", "required": ["minimumAggregateImprovement", "requireNoCriticalRegression"] },
    "fixtures": { "type": "array", "minItems": 1 },
    "resultSets": { "type": "object", "required": ["baseline", "beneficial", "harmful", "no-op"] }
  }
}
